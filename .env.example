# Postgres (local) — for Supabase: pooler URL + session/direct URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/earnings_arena?schema=public"
# Required when DATABASE_URL uses pgbouncer (Supabase transaction pooler :6543)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/earnings_arena?schema=public"

# Privy (https://dashboard.privy.io/) — wallet + email, Solana-only
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"
PRIVY_JWT_VERIFICATION_KEY=""

# Cron + fees
CRON_SECRET="change-me-cron-secret"
ALLOW_SETTLE_OVERRIDES="true"
FEE_INDEXER_STUB="true"
PUMP_API=""
# Local/seed only — never honor this on Vercel/production.
# When true, only demo/seed mints (MintA… / MintB…) skip RPC; real Pump mints
# still require on-chain bonding-curve + creator match. Use mainnet RPC below.
ALLOW_UNVERIFIED_MINTS="true"

# Solana escrow (devnet → mainnet). Use mainnet RPC to verify live Pump mints.
NEXT_PUBLIC_SOLANA_RPC="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_ARENA_PROGRAM_ID=""
KEEPER_SECRET_KEY=""

# Markets + monitoring
FINNHUB_API_KEY="your_finnhub_api_key"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_NAME="Earnings Arena"
